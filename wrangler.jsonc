{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thabyimportados",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "thabyimportados.com.br", "custom_domain": true },
    { "pattern": "www.thabyimportados.com.br", "custom_domain": true }
  ]
}
